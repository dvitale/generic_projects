PROXYMAN_USER=admin
# Almeno 12 caratteri. Il file viene letto dalla shell: mantieni gli apici.
PROXYMAN_PASSWORD=''
PROXYMAN_LISTEN=127.0.0.1:8080
# Abilita solo dopo aver verificato include e permessi Nginx.
PROXYMAN_APPLY=0
PROXYMAN_CONFIG=/etc/nginx/conf.d/proxyman.conf
PROXYMAN_NGINX=/usr/sbin/nginx

# Server Nginx remoti via SSH. Identificativi separati da spazi.
# Esempio: PROXYMAN_REMOTE_IDS='prod backup'
# Lascia vuoto finché non hai compilato i campi.
PROXYMAN_REMOTE_IDS=''

PROXYMAN_REMOTE_PROD_IP=''
PROXYMAN_REMOTE_PROD_PORT=22
PROXYMAN_REMOTE_PROD_USER=''
PROXYMAN_REMOTE_PROD_PASSWORD=''
# Impronta della chiave host Ed25519, ottenuta dalla console del server.
PROXYMAN_REMOTE_PROD_HOST_KEY=''
PROXYMAN_REMOTE_PROD_HOST_KEY_TYPE='ssh-ed25519'
PROXYMAN_REMOTE_PROD_CONFIG='/etc/nginx/conf.d/proxyman.conf'
PROXYMAN_REMOTE_PROD_NGINX='/usr/sbin/nginx'
# 1: esegue tramite sudo -n (richiede sudo senza password sul server).
PROXYMAN_REMOTE_PROD_SUDO=0
PROXYMAN_REMOTE_PROD_APPLY=1

PROXYMAN_REMOTE_BACKUP_IP=''
PROXYMAN_REMOTE_BACKUP_PORT=22
PROXYMAN_REMOTE_BACKUP_USER=''
PROXYMAN_REMOTE_BACKUP_PASSWORD=''
PROXYMAN_REMOTE_BACKUP_HOST_KEY=''
PROXYMAN_REMOTE_BACKUP_HOST_KEY_TYPE='ssh-ed25519'
PROXYMAN_REMOTE_BACKUP_CONFIG='/etc/nginx/conf.d/proxyman.conf'
PROXYMAN_REMOTE_BACKUP_NGINX='/usr/sbin/nginx'
PROXYMAN_REMOTE_BACKUP_SUDO=0
PROXYMAN_REMOTE_BACKUP_APPLY=1
